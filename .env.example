# Copy to .env and adjust. Any key from configs/config.yml can be overridden
# here as UPPER_SNAKE_CASE (db.host -> DB_HOST).

# PostgreSQL password; also used by docker/compose.yaml to initialise the database.
# Generate one with: openssl rand -hex 32
DB_PASSWORD=change-me

# HS256 key used to sign access tokens, at least 32 bytes. The app refuses to
# start while this is empty, including under Compose; delete the line to use
# Compose's local-only default key instead.
# Generate one with: openssl rand -base64 48
AUTH_SIGNING_KEY=
