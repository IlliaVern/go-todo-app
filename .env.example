# Copy to .env and fill in. `make run` and `make up` export these variables;
# use plain KEY=value lines (shell syntax). Optional settings and their
# defaults: PORT=8000, LOG_LEVEL=info, DB_HOST=localhost, DB_PORT=5436,
# DB_USERNAME=postgres, DB_DBNAME=postgres, DB_SSLMODE=disable.

# PostgreSQL password, also used by docker/compose.yaml to initialise the
# database. Generate one with: openssl rand -hex 32
DB_PASSWORD=

# HS256 key used to sign access tokens, at least 32 bytes. The app refuses to
# start while this is empty, including under Compose; delete the line to use
# Compose's local-only default key instead.
# Generate one with: openssl rand -base64 48
AUTH_SIGNING_KEY=
